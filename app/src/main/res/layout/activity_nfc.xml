<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="24dp">

    <!-- Іконка NFC -->
    <TextView
        android:id="@+id/nfc_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱"
        android:textSize="80sp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nfc_status_text"/>

    <!-- ✅ ДОДАНО ID: nfc_status_text -->
    <TextView
        android:id="@+id/nfc_status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="✅ NFC готовий\n\n📱 Піднесіть телефон до NFC-мітки"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Інструкція -->
    <TextView
        android:id="@+id/nfc_instruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="💡 Інструкція:\n\n1. Переконайтеся що NFC увімкнено\n2. Піднесіть задню частину телефону до мітки\n3. Тримайте 1-2 секунди\n4. Двері автоматично відкриються"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:gravity="start"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/nfc_status_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>