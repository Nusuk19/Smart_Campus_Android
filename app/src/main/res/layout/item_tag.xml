<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Icon -->
        <TextView
            android:id="@+id/tag_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="32sp"
            tools:text="💳"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Tag Name -->
        <TextView
            android:id="@+id/tag_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            tools:text="Моя студентська картка"
            app:layout_constraintTop_toTopOf="@id/tag_icon"
            app:layout_constraintStart_toEndOf="@id/tag_icon"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Tag Type -->
        <TextView
            android:id="@+id/tag_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            tools:text="Фізичний тег"
            app:layout_constraintTop_toBottomOf="@id/tag_name"
            app:layout_constraintStart_toEndOf="@id/tag_icon"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Tag UID -->
        <TextView
            android:id="@+id/tag_uid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@android:color/darker_gray"
            tools:text="UID: 04:5E:2A:B2"
            app:layout_constraintTop_toBottomOf="@id/tag_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tag_last_used"/>

        <!-- Last Used -->
        <TextView
            android:id="@+id/tag_last_used"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            tools:text="Використано: 2 год тому"
            app:layout_constraintTop_toTopOf="@id/tag_uid"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>